+// Tug patch: `getScale` divides by `offsetHeight`, an integer, so on a short
+// document the ratio is off by far more than a transform's real noise: one
+// 24.14px line at a 0.8 transform reads 19.31 / 24 = 0.8047. That sits inside
+// the 0.005 the measure pass requires before it adopts a new scale, so the
+// wrong value then outlives the document's growth, and every height conversion
+// in the view is 0.6% out for good. The computed size is unrounded, so the ratio
+// is exact and the adoption threshold can be tight enough to mean it.
+function exactScale(elt, rect, style) {
+    let width = parseFloat(style.width), height = parseFloat(style.height);
+    if (!(width > 0) || !(height > 0))
+        return getScale(elt, rect);
+    return { scaleX: rect.width / width, scaleY: rect.height / height };
+}
+
 function getScale(elt, rect) {
     let scaleX = rect.width / elt.offsetWidth;
     let scaleY = rect.height / elt.offsetHeight;
@@ -6271,9 +6285,9 @@ class ViewState {
         this.mustMeasureContent = false;
         let result = 0, bias = 0;
         if (domRect.width && domRect.height) {
-            let { scaleX, scaleY } = getScale(dom, domRect);
-            if (scaleX > .005 && Math.abs(this.scaleX - scaleX) > .005 ||
-                scaleY > .005 && Math.abs(this.scaleY - scaleY) > .005) {
+            let { scaleX, scaleY } = exactScale(dom, domRect, style);
+            if (scaleX > .005 && Math.abs(this.scaleX - scaleX) > .0001 ||
+                scaleY > .005 && Math.abs(this.scaleY - scaleY) > .0001) {
                 this.scaleX = scaleX;
                 this.scaleY = scaleY;
                 result |= 16 /* UpdateFlag.Geometry */;
