{
  "name": "tugdeck",
  "version": "0.8.10",
  "private": true,
  "license": "MIT",
  "description": "Browser frontend for Tug — renders feeds from tugcast as interactive UI",
  "scripts": {
    "build": "vite build",
    "check": "bunx tsc --noEmit",
    "dev": "vite",
    "extract:tug-token-names": "bun run scripts/extract-tug-token-names.ts",
    "audit:tokens": "bun run scripts/audit-tokens.ts",
    "audit:visibility": "bun run scripts/audit-visibility.ts",
    "audit:settle-motion": "bun run scripts/audit-settle-motion.ts",
    "audit:theme-contrast": "bun run scripts/audit-theme-contrast.ts",
    "audit:gamut": "bun run scripts/audit-gamut.ts",
    "generate:rename-maps": "bun run scripts/generate-rename-maps.ts",
    "fetch:fonts": "bun run scripts/fetch-fonts.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-focus-scope": "^1.1.8",
