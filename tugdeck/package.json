    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.2.2",
    "katex": "^0.17.0",
    "linkify-element": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lucide": "^0.564.0",
    "lucide-react": "^1.21.0",
    "marked": "^15.0.6",
    "mermaid": "^11.15.0",
