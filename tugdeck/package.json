  "//overrides": "CodeMirror 6 identifies facets and compartments by object reference, so a second copy of any @codemirror package is a second, unconfigured set of them. @codemirror/commands pulled a nested @codemirror/language, whose indentUnit facet the editors never configured. Pinned EXACT so install cannot reintroduce a copy and cannot move the editors onto a release nobody has looked at: view 6.43 rewrote the content-DOM update path and the composer flickered under a streamed draft. Bump these deliberately, with the editors in front of you. vite's resolve.dedupe guards the bundle.",
  "overrides": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.1",
    "@codemirror/language": "6.12.4"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "bun-types": "^1.3.11",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
