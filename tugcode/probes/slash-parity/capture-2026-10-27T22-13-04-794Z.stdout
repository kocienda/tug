ue.mcpServers // {}) | length > 0)) | map(\"\\(.key): \\((.value.mcpServers|keys))\") | .[]' \"$CJ\"\n\nsec \"skillUsage\"\njq -r '.skillUsage // {} | to_entries | map(\"\\(.key)\\t\\(.value.usageCount)\\t\\(.value.lastUsedAt)\") | .[]' \"$CJ\"\nsec \"pluginUsage\"\njq -r '.pluginUsage // {} | to_entries | map(\"\\(.key)\\t\\(.value.usageCount)\\t\\(.value.lastUsedAt)\") | .[]' \"$CJ\"\n\nsec \"skills dirs\"\necho \"user skills:\"; ls \"$HOME/.claude/skills\" 2>&1\necho \"project:\"; ls -la \"$PROJ\" 2>&1; ls -la \"$PROJ/.claude\" 2>&1\necho \"user agents:\"; ls \"$HOME/.claude/agents\" 2>&1\necho \"plugins dir:\"; ls \"$HOME/.claude/plugins\" 2>&1\necho \"installed_plugins.json:\"; jq -r '.' \"$HOME/.claude/plugins/installed_plugins.json\" 2>/dev/null | head -60\n\nsec \"claude.md files\"\nls -la \"$HOME/.claude/CLAUDE.md\" \"$PROJ/CLAUDE.md\" \"$PROJ/CLAUDE.local.md\" \"$PROJ/.claude/CLAUDE.md\" /private/tmp/CLAUDE.local.md /tmp/CLAUDE.local.md 2>&1\nls \"$PROJ/.claude/rules\" 2>&1\nwc -c \"$HOME/.claude/CLAUDE.md\" 2>&1\n\nsec \"transcripts\"\nls -d \"$HOME/.claude/projects\"/* 2>/dev/null | wc -l\nls -t \"$HOME/.claude/projects\"/*/*.jsonl 2>/dev/null | head -50 > /tmp/doctor-transcripts.$$.txt\necho \"count: $(wc -l < /tmp/doctor-transcripts.$$.txt)\"\necho \"oldest mtime:\"; tail -1 /tmp/doctor-transcripts.$$.txt | xargs stat -f '%Sm %N'\necho \"newest mtime:\"; head -1 /tmp/doctor-transcripts.$$.txt | xargs stat -f '%Sm %N'\nmv /tmp/doctor-transcripts.$$.txt \"$PROJ/.doctor-transcripts.txt\"\n"}}}
